class Redactor:
    """Replaces every known form of the unit serial (any case) by <serial>."""

    def __init__(self):
        self.words: set[str] = set()
        self.pattern: re.Pattern | None = None

    def add_serial(self, serial_text: str) -> None:
        """Add a 12-hex serial, in the sysfs form and in RomInfo's raw (nibble-swapped back) form."""
        if not serial_text:
            return
        self.words.add(serial_text.lower())
        if SERIAL_RE.fullmatch(serial_text.lower()):
            self.words.add(serial_hex(bytes.fromhex(serial_text.lower())))
        self.pattern = re.compile(
            "|".join(re.escape(w) for w in sorted(self.words, key=len, reverse=True)), re.IGNORECASE
        )

    def __call__(self, text: str) -> str:
        return self.pattern.sub(REDACTED, text) if self.pattern else text


class NullLog:
    path = ""

    def write(self, kind: str, text: str) -> None:
        pass

    def close(self) -> None:
        pass


class SetupLog:
    """Append-only text log, 0600 root (the test user under a test root), every line redacted."""

    def __init__(self, cfg: Config, redact: Redactor):
        self.path, self.redact = cfg.log_path, redact
        flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NOCTTY | os.O_NONBLOCK
        try:
            fd = os.open(self.path, flags, FILE_MODE)
        except OSError as exc:
            if exc.errno == errno.ELOOP:
                raise Fail(f"the log {self.path} is a symlink; refusing to write through it") from None
            raise Fail(f"cannot open the log {self.path}: {exc.strerror}") from None
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
                raise Fail(f"the log {self.path} is not a plain file (or has other hard links); remove it")
            if cfg.test_root:
                if st.st_uid != cfg.expect_uid:
                    raise Fail(f"the log {self.path} is owned by {user_name(st.st_uid)}; remove it")
            else:
                os.fchown(fd, 0, 0)
            os.fchmod(fd, FILE_MODE)
        except BaseException:
            os.close(fd)
            raise
        self.fd = fd

    def write(self, kind: str, text: str) -> None:
        if self.fd is None:
            return
        stamp = datetime.datetime.now().astimezone().isoformat(timespec="milliseconds")
        lines = self.redact(str(text)).replace("\r", " ").split("\n")
        data = "".join(f"{stamp} {kind:<6} {line}\n" for line in lines)
        with contextlib.suppress(OSError):
            os.write(self.fd, data.encode("utf-8", "replace"))

    def close(self) -> None:
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None


class LogLines:
    """A text stream (for redirect_stdout) that sends every line to the log."""

    def __init__(self, log, kind: str = "FILES"):
        self.log, self.kind, self.buf = log, kind, ""

    def write(self, text: str) -> int:
        self.buf += text
        while "\n" in self.buf:
            line, self.buf = self.buf.split("\n", 1)
            self.log.write(self.kind, line)
        return len(text)

    def flush(self) -> None:
        if self.buf:
            self.log.write(self.kind, self.buf)
            self.buf = ""


def serial_hex(raw: bytes) -> str:
    """The driver's rule: each of the 6 RomInfo serial bytes nibble-swapped, as lowercase hex."""
    return "".join(f"{((b & 0x0F) << 4) | (b >> 4):02x}" for b in raw)


@dataclasses.dataclass(frozen=True)
class Reader:
    name: str  # the sysfs device name, e.g. 1-3
    serial: str  # the USB serial, lowercased ("" if unreadable)


def _read_attr(directory: str, name: str) -> str | None:
    try:
        with open(os.path.join(directory, name), "rb") as fh:
            raw = fh.read(256)
    except OSError:
        return None
    return raw.decode("ascii", "replace").strip()


def find_readers(cfg: Config) -> list[Reader]:
    """Every 06cb:0078 USB device in sysfs (idVendor, idProduct, serial); no USB I/O."""
    base = os.path.join(cfg.sysfs, "bus", "usb", "devices")
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return []
    out = []
    for name in names:
        if ":" in name:  # an interface, not a device
            continue
        d = os.path.join(base, name)
        if (_read_attr(d, "idVendor"), _read_attr(d, "idProduct")) == READER_IDS:
            out.append(Reader(name, (_read_attr(d, "serial") or "").lower()))
    return out


# ------------------------------------------------------------------- one run


def now_iso() -> str:
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def _safe(text: str, limit: int = 120) -> str:
    out = "".join(c if 32 <= ord(c) < 127 else "?" for c in str(text))
    return out if len(out) <= limit else out[: limit - 3] + "..."


class Run:
    """One install, recalibrate, fetch or status run: the config, the package, the pins, the log."""

    def __init__(self, cfg: Config, pk: Package, command: str, *, dry_run: bool = False, yes: bool = False):
        self.cfg, self.pk, self.command = cfg, pk, command
        self.dry_run, self.yes = dry_run, yes
        self.redact = Redactor()
        self.log = NullLog()
        self.pins = self._load_pins()
        self.archives = self._load_archives()
        self.known = frozenset(a.sha256 for a in self.archives)
        self.vendor_dir = os.path.join(cfg.setup_dir, VENDOR_NAME)
        self.backup_dir = os.path.join(cfg.setup_dir, BACKUP_NAME)
        self._fake = None

    # -- inputs ---------------------------------------------------------------

    def _load_pins(self):
        if not self.cfg.pins_path:
            return self.pk.pins.DEFAULT_PINS
        try:
            with open(self.cfg.pins_path, encoding="utf-8") as fh:
                pins = self.pk.pins.Pins.from_json(fh.read(MAX_SMALL_FILE))
        except (OSError, ValueError) as exc:
            raise Fail(f"{TEST_PINS_VAR}: {exc}", code=2) from None
        if pins.module_sha256 != self.cfg.module_sha256:
            raise Fail(f"{TEST_PINS_VAR}: the module pin changed while the tool ran", code=2)
        return pins

    def _load_archives(self):
        if not self.cfg.archives_path:
            return tuple(self.pk.pins.ARCHIVES)
        Archive = self.pk.pins.Archive
        try:
            with open(self.cfg.archives_path, encoding="utf-8") as fh:
                doc = json.loads(fh.read(MAX_SMALL_FILE))
            out = tuple(Archive(**d) for d in doc)
        except (OSError, ValueError, TypeError, RecursionError) as exc:
            raise Fail(f"{TEST_ARCHIVES_VAR}: not a list of archives ({exc})", code=2) from None
        for a in out:
            if not (SHA256_RE.fullmatch(a.sha256) and CACHE_NAME_RE.fullmatch(f"{a.sha256}-{a.name}")):
                raise Fail(f"{TEST_ARCHIVES_VAR}: bad archive entry {a.name!r}", code=2)
        return out

    # -- output ---------------------------------------------------------------

    def say(self, text: str) -> None:
        self.log.write("SAY", text)
        say(self.redact(text))

    def begin(self, text: str) -> None:
        self.log.write("SAY", text)
        begin(self.redact(text))

    def finish(self, text: str) -> None:
        self.log.write("SAY", text)
        finish(self.redact(text))

    def next_command(self) -> str:
        return f"sudo {PROG} {self.command}"

    @contextlib.contextmanager
    def logged(self):
        """The log open for the run (not in a dry run); a failure is logged before it is shown."""
        if not self.dry_run:
            self.log = SetupLog(self.cfg, self.redact)
            self.log.write("INFO", f"{PROG} {TOOL_VERSION} {self.command} started (pid {os.getpid()})")
            self.log.write("INFO", f"package {self.pk.pkgdir}, pins: template {self.pins.template_sha256}")
        try:
            yield
        except Fail as exc:
            self.log.write("FAILED", f"{exc} | {exc.hint}" if exc.hint else str(exc))
            raise Fail(self.redact(str(exc)), self.redact(exc.hint), exc.code) from None
        except KeyboardInterrupt:
            self.log.write("WARN", "interrupted")
            raise
        except OSError as exc:
            self.log.write("ERROR", f"{exc!r}\n{traceback.format_exc()}")
            raise Fail(
                f"{self.redact(str(exc))} (details in the log: {self.cfg.log_path})", hint=self.next_command()
            ) from None
        except Exception as exc:  # noqa: BLE001 (a bug: the traceback goes to the log only)
            self.log.write("ERROR", f"unexpected: {exc!r}\n{traceback.format_exc()}")
            raise Fail(
                f"Stopped by an unexpected error in this program (details in the log: {self.cfg.log_path}).",
                code=1,
            ) from None
        finally:
            self.log.write("INFO", "finished")
            self.log.close()
            self.log = NullLog()

    # -- small files in this tool's own directories ----------------------------

    def open_setup_dir(self, sub: str | None = None, make: bool = True) -> int | None:
        """An fd of /var/lib/synaptics0078 (or its `sub`), made 0700 if `make`; None if absent."""
        cfg = self.cfg
        parent = os.path.dirname(cfg.setup_dir)
        pfd = os.open(parent, _RDONLY | os.O_DIRECTORY)
        try:
            try:
                fd, created = open_or_make_dir(pfd, os.path.basename(cfg.setup_dir), cfg.setup_dir, make, cfg)
            except FileNotFoundError:
                return None
        finally:
            os.close(pfd)
        if not created and make and stat.S_IMODE(os.fstat(fd).st_mode) != DIR_MODE:
            os.fchmod(fd, DIR_MODE)
        if sub is None:
            return fd
        try:
            try:
                sfd, created = open_or_make_dir(fd, sub, os.path.join(cfg.setup_dir, sub), make, cfg)
            except FileNotFoundError:
                return None
        finally:
            os.close(fd)
        if not created and make and stat.S_IMODE(os.fstat(sfd).st_mode) != DIR_MODE:
            os.fchmod(sfd, DIR_MODE)
        return sfd

    def read_json_at(self, dir_fd: int, name: str) -> dict:
        try:
            doc = json.loads(read_capped(name, MAX_SMALL_FILE, dir_fd=dir_fd).decode("utf-8"))
        except (BadFile, ValueError, UnicodeDecodeError, RecursionError):  # nested too deep: corrupt too
            return {}
        return doc if isinstance(doc, dict) else {}

    def calibration_record(self) -> dict:
        fd = self.open_setup_dir(make=False) if os.path.isdir(self.cfg.setup_dir) else None
        if fd is None:
            return {}
        try:
            return self.read_json_at(fd, CALIBRATION_NAME)
        finally:
            os.close(fd)

    def write_calibration_record(self, record: dict) -> None:
        fd = self.open_setup_dir()
        try:
            write_atomic(fd, CALIBRATION_NAME, (json.dumps(record, indent=2, sort_keys=True) + "\n").encode(), self.cfg)
            os.fsync(fd)
        finally:
            os.close(fd)


# ------------------------------------------------------------ vendor files


@dataclasses.dataclass
class Gathered:
    """The pinned module and template collected so far, and where they came from."""

    module: bytes | None = None
    template: bytes | None = None
    label: str = ""

    def satisfied(self, need_module: bool, need_template: bool) -> bool:
        return (self.module is not None or not need_module) and (self.template is not None or not need_template)

    def take(self, run: Run, ex) -> bool:
        """Keep what `ex` gave (pins checked again here); True when it added something."""
        v, added = run.pk.vendor, False
        if self.module is None and ex.module is not None and v.is_module(ex.module, run.pins):
            self.module, added = bytes(ex.module), True
        if self.template is None and ex.template is not None and v.is_template(ex.template, run.pins):
            self.template, added = bytes(ex.template), True
        return added


def curl_argv(curl: str, archive, output: str) -> list[str]:
    """The exact curl call (design decision 5): -q first, https only, capped in size and time."""
    return [
        curl,
        "-q",
        "--proto",
        "=https",
        "--proto-redir",
        "=https",
        "--tlsv1.2",
        "--fail",
        "--location",
        "--max-redirs",
        "3",
        "--connect-timeout",
        "20",
        "--max-time",
        str(archive.max_time),
        "--max-filesize",
        str(archive.max_bytes),
        "--retry",
        str(CURL_RETRIES),
        "--retry-delay",
        str(CURL_RETRY_DELAY_S),
        "--silent",
        "--show-error",
        "--remove-on-error",
        "--output",
        output,
        archive.url,
    ]


def curl_timeout_s(archive) -> int:
    """The wall-clock cap of one curl run: every try at its --max-time, the delays between, a margin.

    A backstop only: curl stops each try itself. A server's Retry-After can make curl wait
    longer than --retry-delay; this cap then ends the run (a failed source).
    """
    return (CURL_RETRIES + 1) * archive.max_time + CURL_RETRIES * CURL_RETRY_DELAY_S + CURL_MARGIN_S


def setpriv_argv(run: Run) -> list[str]:
    """The unprivileged extractor (design decision 4): nobody, no groups, no new privileges, capped.

    prlimit runs after setpriv, as nobody already (lowering a limit needs no privilege),
    and the limits hold across its exec of python and the bsdtar children (CHILD_RLIMITS).
    `--` ends prlimit's options: python's own are not read as prlimit's. The session of
    its own (no controlling terminal: /dev/tty cannot be opened) comes from
    vendor.run_capped, which kills the child's whole process group on every way out. The
    child keeps its bsdtar runs in that group (vendor.child_main), so they die with it; a
    process that starts a session of its own escapes it (NPROC and CPU caps still hold).
    """
    argv = [
        run.cfg.setpriv,
        f"--reuid={NOBODY}",
        f"--regid={NOBODY}",
        "--clear-groups",
        "--no-new-privs",
        run.cfg.prlimit,
        *(f"--{name}={value}" for name, value in CHILD_RLIMITS),
        "--",
        PYTHON,
        "-IB",
        "-c",
        child_code(run.pk.pkgdir),
    ]
    if run.cfg.pins_path:
        argv += ["--pins", run.cfg.pins_path]
    return argv


def extract_in_child(run: Run, data: bytes):
    """vendor.extract run as nobody; the framed output re-checked against every pin here."""
    v = run.pk.vendor
    argv = setpriv_argv(run)
    run.log.write("INFO", f"unprivileged extractor: {argv[0]} ... {PYTHON} -IB -c <vendor.child_entry>")
    try:
        rc, out, err = v.run_capped(argv, data, v.MAX_CHILD_OUTPUT, CHILD_TIMEOUT_S)
    except OSError as exc:
        raise v.VendorError(f"cannot run {argv[0]}: {exc.strerror or exc}") from None
    if err.strip():
        run.log.write("CHILD", _safe(err.strip(), 2000))
    run.log.write("INFO", f"extractor exit {rc}, {len(out)} bytes of output")
    return v.parse_child_output(out, pins=run.pins)


def extract_bytes(run: Run, data: bytes, name: str, known: bool):
    """What `data` gives: the bare module or template here, a known archive in this process,
    anything else in the unprivileged child. None when it cannot be read at all."""
    v = run.pk.vendor
    if v.is_module(data, run.pins):
        return v.Extracted(module=bytes(data), provenance=[f"{name}: the bare module"])
    if v.is_template(data, run.pins):
        return v.Extracted(template=bytes(data), provenance=[f"{name}: the bare template"])
    try:
        if known:
            run.log.write("INFO", f"{name}: a known archive (sha256 pinned): parsed in this process")
            ex = v.extract(data, name=name, pins=run.pins)
        else:
            run.log.write("INFO", f"{name}: not a known archive: parsed by the unprivileged extractor")
            ex = extract_in_child(run, data)
    except v.VendorError as exc:
        run.log.write("WARN", f"{name}: {exc}")
        return None
    for line in ex.provenance:
        run.log.write("VENDOR", line)
    return ex


def gave_text(ex) -> list[str]:
    return [w for w, b in (("module", ex.module), ("template", ex.template)) if b is not None]


def update_manifest(run: Run, vfd: int, name: str, entry: dict) -> None:
    manifest = run.read_json_at(vfd, MANIFEST_NAME)
    manifest[name] = entry
    write_atomic(vfd, MANIFEST_NAME, (json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode(), run.cfg)


def cache_store(run: Run, vfd: int, data: bytes, suffix: str, entry: dict) -> str:
    sha = hashlib.sha256(data).hexdigest()
    name = f"{sha}-{suffix}"
    write_atomic(vfd, name, data, run.cfg)
    update_manifest(run, vfd, name, {**entry, "date": now_iso(), "size": len(data), "sha256": sha})
    os.fsync(vfd)
    run.log.write("INFO", f"cached as {run.vendor_dir}/{name}")
    return name


def cache_names(run: Run, vfd: int) -> list[str]:
    order = {f"{a.sha256}-{a.name}": i for i, a in enumerate(run.archives)}
    names = [n for n in os.listdir(vfd) if CACHE_NAME_RE.fullmatch(n)]
    return sorted(names, key=lambda n: (order.get(n, len(order)), n))


def entry_label(run: Run, name: str, manifest: dict) -> str:
    entry = manifest.get(name)
    if isinstance(entry, dict) and isinstance(entry.get("label"), str):
        return _safe(entry["label"], 60)
    sha = name[:64]
    for a in run.archives:
        if a.sha256 == sha:
            return a.label
    return "a file given earlier"


def gather_from_cache(run: Run, g: Gathered, need_module: bool, need_template: bool, tried: set) -> bool:
    """Use the cached vendor files; a corrupt entry (content not its sha256, too large) is removed."""
    vfd = run.open_setup_dir(VENDOR_NAME, make=False) if os.path.isdir(run.cfg.setup_dir) else None
    if vfd is None:
        run.log.write("INFO", "vendor cache: none yet")
        return False
    try:
        manifest = run.read_json_at(vfd, MANIFEST_NAME)
        for name in cache_names(run, vfd):
            sha = name[:64]
            try:
                data = read_capped(name, run.pk.vendor.MAX_INPUT, dir_fd=vfd)
            except BadFile as exc:
                run.log.write("WARN", f"vendor cache {name}: {exc}; removed")
                with contextlib.suppress(OSError):
                    os.unlink(name, dir_fd=vfd)
                continue
            if hashlib.sha256(data).hexdigest() != sha:
                run.log.write("WARN", f"vendor cache {name}: its content does not have the sha256 of its name; removed")
                with contextlib.suppress(OSError):
                    os.unlink(name, dir_fd=vfd)
                continue
            tried.add(sha)
            label = entry_label(run, name, manifest)
            ex = extract_bytes(run, data, f"cache {name[64:].lstrip('-')}", sha in run.known)
            if ex is None or not g.take(run, ex):
                run.log.write("INFO", f"vendor cache {name}: gave nothing needed")
                continue
            g.label = g.label or label
            if g.satisfied(need_module, need_template):
                run.say(f"Using the vendor files saved earlier ({label})... done, checked.")
                return True
    finally:
        os.close(vfd)
    return False


def download(run: Run, archive, vfd: int) -> bytes | None:
    """One archive by curl into a private temp file in the cache dir, read once with its cap; None on failure."""
    tmp = f".download-{secrets.token_hex(8)}.tmp"
    argv = curl_argv(run.cfg.curl, archive, os.path.join(run.vendor_dir, tmp))
    run.log.write("INFO", f"curl {archive.url} (cap {archive.max_bytes} bytes, {archive.max_time} s)")
    env = {**_ENV_MIN, **dict(run.cfg.proxies)}
    try:
        try:
            r = subprocess.run(
                argv,
                stdin=subprocess.DEVNULL,
                capture_output=True,
                timeout=curl_timeout_s(archive),
                env=env,
                cwd="/",
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            run.log.write("WARN", f"curl could not run: {exc}")
            return None
        if r.returncode != 0:
            text = r.stderr.decode("utf-8", "replace").strip()
            run.log.write("WARN", f"curl exit {r.returncode}: {_safe(text, 500)}")
            return None
        try:
            data = read_capped(tmp, archive.max_bytes, dir_fd=vfd)
        except BadFile as exc:
            run.log.write("WARN", f"download {exc}")
            return None
        run.log.write("INFO", f"downloaded {len(data)} bytes, sha256 {hashlib.sha256(data).hexdigest()}")
        return data
    finally:
        with contextlib.suppress(OSError):
            os.unlink(tmp, dir_fd=vfd)


def gather_from_network(run: Run, g: Gathered, need_module: bool, need_template: bool, tried: set) -> None:
    """The sources in order, stopping at the first that completes what is needed; cached. Fail otherwise."""
    vfd = run.open_setup_dir(VENDOR_NAME)
    try:
        todo = [a for a in run.archives if a.sha256 not in tried]
        for i, a in enumerate(todo):
            run.begin(f"Getting the vendor files ({a.label})... ")
            data = download(run, a, vfd)
            ex = None
            if data is not None:
                sha = hashlib.sha256(data).hexdigest()
                if sha != a.sha256:
                    run.log.write("WARN", f"{a.name}: sha256 {sha} is not the pinned {a.sha256}; parsed unprivileged")
                ex = extract_bytes(run, data, a.name, sha in run.known)
            if ex is not None and g.take(run, ex):
                cache_store(run, vfd, data, a.name, {"url": a.url, "label": a.label, "gave": gave_text(ex)})
                g.label = g.label or a.label
                if g.satisfied(need_module, need_template):
                    run.finish("done, checked.")
                    return
            run.finish("not available." if i + 1 == len(todo) else "not available, trying the next source.")
    finally:
        os.close(vfd)
    if run.cfg.proxies:
        raise Fail(MSG_NO_DOWNLOAD, hint=f"details in the log: {run.cfg.log_path}")
    raise Fail(
        MSG_NO_DOWNLOAD,
        hint=f"behind a proxy (sudo drops https_proxy), run: sudo --preserve-env=https_proxy {PROG} {run.command}",
    )


def gather_from_files(run: Run, files: list[str], g: Gathered, need_module: bool, need_template: bool) -> None:
    """--from-file: each file read once (owner checked through sudo); what it gives is cached."""
    cfg, v = run.cfg, run.pk.vendor
    if cfg.source_unchecked:
        run.log.write(
            "NOTE", f"not run through sudo ({SUDO_UID_VAR} is not set): the owner of the files is not checked"
        )
    vfd = None
    try:
        for given in files:
            path = os.path.abspath(given)
            run.begin(f"Reading the vendor files ({path})... ")
            try:
                data = read_capped(path, v.MAX_INPUT, cfg.source_uid)
            except BadFile as exc:
                run.finish("refused.")
                raise Fail(
                    f"{path} {exc}", hint=f"give a file of your own: sudo {PROG} {run.command} --from-file FILE"
                ) from None
            sha = hashlib.sha256(data).hexdigest()
            ex = extract_bytes(run, data, os.path.basename(path), sha in run.known)
            if ex is None or not g.take(run, ex):
                run.finish("nothing usable in it.")
                continue
            if vfd is None:
                vfd = run.open_setup_dir(VENDOR_NAME)
            kind = v.detect(data, run.pins) or "file"
            suffix = next((a.name for a in run.archives if a.sha256 == sha), f"file-{kind}")
            label = next(
                (a.label for a in run.archives if a.sha256 == sha), f"--from-file {_safe(os.path.basename(path), 60)}"
            )
            cache_store(run, vfd, data, suffix, {"url": "--from-file", "label": label, "gave": gave_text(ex)})
            g.label = g.label or label
            run.finish("done, checked.")
    finally:
        if vfd is not None:
            os.close(vfd)
    if g.satisfied(need_module, need_template):
        return
    if need_template and g.template is None and g.module is not None:
        raise Fail(MSG_BARE_MODULE, hint=f"sudo {PROG} {run.command} --from-file MODULE --from-file DLL_OR_ARCHIVE")
    raise Fail(
        "The files given do not contain the vendor files this reader needs (the module and the DLL tables), "
        "so nothing was written.",
        hint=f"use one of the archives {PROG} status lists: sudo {PROG} {run.command} --from-file FILE",
    )


def acquire(run: Run, files: list[str], module: bytes | None, need_module: bool, need_template: bool) -> Gathered:
    g = Gathered(module=module)
    if files:
        gather_from_files(run, files, g, need_module, need_template)
        return g
    tried: set = set()
    if gather_from_cache(run, g, need_module, need_template, tried):
        return g
    gather_from_network(run, g, need_module, need_template, tried)
    return g


# ------------------------------------------------------------ the installed state


@dataclasses.dataclass
class Installed:
    module: bytes | None = None  # the installed module.bin, when valid
    program: bytes | None = None  # the installed program for this reader, if it has the right size
    program_present: bool = False
    program_ok: bool = False
    program_why: str | None = None
    unreadable: bool = False  # not root: /var/lib/fprint could not be looked into


def program_check(run: Run, serial: str, data: bytes) -> str | None:
    """Why `data` is not a valid program for program-<serial>.bin, or None (the template pin, decision 10)."""
    if why := program_problem(serial, data):
        return why
    if run.cfg.check_template:
        good, why = run.pk.template.program_matches_template(data, pins=run.pins)
        if not good:
            return f"does not match the template: {why}"
    return None


def inspect_installed(run: Run, serial: str) -> Installed:
    cfg, out = run.cfg, Installed()
    try:
        st = lstat_or_none(cfg.data_dir)
    except PermissionError:
        out.unreadable = True
        return out
    if st is None or not stat.S_ISDIR(st.st_mode):
        return out
    for name, size in ((MODULE_NAME, MODULE_SIZE), (program_name(serial), PROGRAM_SIZE)):
        try:
            _, data = read_installed(os.path.join(cfg.data_dir, name), size)
        except FileNotFoundError:
            continue
        except PermissionError:
            out.unreadable = True
            continue
        except (BadFile, OSError) as exc:
            run.log.write("WARN", f"installed {name}: {exc}")
            if name != MODULE_NAME:
                out.program_present, out.program_why = True, str(exc)
            continue
        if name == MODULE_NAME:
            if data is not None and module_problem(data, cfg.module_sha256) is None:
                out.module = data
            else:
                run.log.write("INFO", "installed module.bin is not valid")
            continue
        out.program_present, out.program = True, data
        if data is None:
            out.program_why = "has the wrong size"
        else:
            out.program_why = program_check(run, serial, data)
        out.program_ok = out.program_why is None
        run.log.write("INFO", f"installed {name}: " + ("valid" if out.program_ok else f"not valid: {out.program_why}"))
    return out


def resplice_pin(run: Run, program: bytes) -> str | None:
    """The earlier template pin the installed program's fixed part matches, or None (decision 11)."""
    try:
        zeroed = run.pk.template.zero_unit_regions(program)
    except run.pk.calibration.CalibrationError:
        return None
    old = set(PREVIOUS_TEMPLATE_SHA256)
    recorded = run.calibration_record().get("template_sha256")
    if isinstance(recorded, str) and SHA256_RE.fullmatch(recorded):
        old.add(recorded)
    old.discard(run.pins.template_sha256)
    got = hashlib.sha256(zeroed).hexdigest()
    return got if got in old else None


def one_reader(run: Run) -> Reader:
    readers = find_readers(run.cfg)
    run.log.write("INFO", f"sysfs: {len(readers)} reader(s) 06cb:0078: {', '.join(r.name for r in readers) or '-'}")
    if not readers:
        raise Fail(MSG_NOT_FOUND)
    if len(readers) > 1:
        raise Fail(
            f"{len(readers)} readers 06cb:0078 were found; this tool sets up one. Unplug the others, then run again."
        )
    reader = readers[0]
    if not SERIAL_RE.fullmatch(reader.serial):
        raise Fail(
            "The reader's USB serial number cannot be read from sysfs, so its program cannot be named. "
            "Restart the computer, then run the same command again."
        )
    run.redact.add_serial(reader.serial)
    return reader


# ------------------------------------------------------------- the calibration


def systemctl(run: Run, *args: str) -> int | None:
    argv = [run.cfg.systemctl, *args]
    try:
        r = subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            timeout=SYSTEMCTL_TIMEOUT_S,
            env=_ENV_MIN,
            cwd="/",
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        run.log.write("WARN", f"systemctl {' '.join(args)}: {exc}")
        return None
    text = (r.stdout + r.stderr).decode("utf-8", "replace").strip()
    run.log.write(
        "INFO", f"systemctl {' '.join(args)}: exit {r.returncode}" + (f": {_safe(text, 300)}" if text else "")
    )
    return r.returncode


def stop_fprintd(run: Run, again: bool = False) -> None:
    """Stop fprintd if it is active (it is D-Bus activated and starts again on demand)."""
    if not again:
        if systemctl(run, "is-active", "--quiet", "fprintd") != 0:
            return
        systemctl(run, "stop", "fprintd")
        run.say("Stopped fprintd for the calibration (it starts again by itself when needed).")
        return
    systemctl(run, "stop", "fprintd")


def make_transport(run: Run, guard):
    if run.cfg.transport_path:
        if run._fake is None:
            spec = importlib.util.spec_from_file_location("synaptics0078_setup_test_transport", run.cfg.transport_path)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            run._fake = module
        return run._fake.make_transport(run.log, guard)
    if run.cfg.test_root:
        raise Fail(f"no fake transport under the test root (set {TEST_TRANSPORT_VAR}); nothing was calibrated", code=2)
    return run.pk.session.UsbTransport(run.log, guard=guard)


def open_failure(run: Run, exc) -> Fail:
    s = run.pk.session
    log = run.cfg.log_path
    if exc.reason == "pyusb is missing":
        return Fail("pyusb is not installed, so the reader cannot be used.", hint="sudo pacman -S python-pyusb")
    if exc.rc == s.EXIT_NOT_FOUND and exc.reason == "reader not found":
        return Fail(MSG_NOT_FOUND)
    return Fail(f"{exc.user} Nothing was written.", hint=f"run again: {run.next_command()}   (log: {log})")


def open_reader(run: Run, guard):
    """Claim the reader; on busy stop fprintd once more, wait 1 s, retry once."""
    s = run.pk.session
    for attempt in (1, 2):
        transport = make_transport(run, guard)
        try:
            transport.open()
            return transport
        except s.StepFailed as exc:
            run.log.write("ERROR", f"opening the reader: {exc} ({exc.reason})")
            with contextlib.suppress(Exception):
                transport.close()
            if exc.rc != s.EXIT_DRIVER_BUSY:
                raise open_failure(run, exc) from None
        if attempt == 2:
            raise Fail(
                "The reader is still in use by another program. Close every fingerprint prompt "
                "(lock screen, login, settings), then run again.",
                hint=run.next_command(),
            )
        run.log.write("INFO", f"the reader is busy: stopping fprintd once more, retrying in {BUSY_WAIT_S} s")
        stop_fprintd(run, again=True)
        sleep(BUSY_WAIT_S)
    raise AssertionError("unreachable")


def fingers_off(run: Run, first: bool) -> None:
    if run.yes or not stdin_is_tty():
        lead = "Keep your fingers OFF the reader" if first else "The reader seemed touched; lift your fingers"
        run.say(f"{lead}; starting in {COUNTDOWN_S} seconds.")
        sleep(COUNTDOWN_S)
        return
    run.say(MSG_FINGERS_OFF if first else MSG_TOUCHED)
    if read_line() == "":
        raise Fail("Cancelled (end of input); nothing was written.", hint=run.next_command())


def sequence_class(session):
    """CalibrationSequence that stops after the four reads when the module or the serial is wrong."""

    class SetupSequence(session.CalibrationSequence):
        expected_serial = ""

        def read_identity(self):
            out = super().read_identity()
            u1 = self.state.rom_u1
            if u1 not in (0, session.EXPECTED_BYTE17_AFTER_MODULE):
                raise WrongModule(u1)
            if serial_hex(self.rom_serial or b"") != self.expected_serial:
                raise SerialMismatch()
            return out

    return SetupSequence


def session_failure(run: Run, exc: BaseException) -> Fail:
    """The user's line for an error inside the calibration sequence (details are in the log)."""
    s, log, again = run.pk.session, run.cfg.log_path, run.next_command()
    if isinstance(exc, WrongModule):
        shown = "unknown" if exc.args[0] is None else f"0x{exc.args[0]:02x}"
        run.log.write("ERROR", f"RomInfo byte 17 is {shown}: another capture module is loaded")
        return Fail(
            "Another capture module is loaded in the reader (for example after Windows used it), so nothing "
            "was written. Restart the computer, then run again.",
            hint=again,
        )
    if isinstance(exc, SerialMismatch):
        run.log.write("ERROR", "the RomInfo serial differs from the sysfs USB serial")
        return Fail(
            "The reader reported a different serial number than the one seen on USB, so nothing was written. "
            "Restart the computer, then run again.",
            hint=again,
        )
    if isinstance(exc, s.UnsafeCommand):
        run.log.write("ERROR", f"refused to send: {exc}")
        return Fail(
            f"Stopped before sending a command that is not allowed, so nothing was written (details in the log: {log}).",
            hint="the vendor files or this tool do not match; report the log",
        )
    if isinstance(exc, s.StepFailed):
        run.log.write("ERROR", f"{exc} ({exc.reason})")
        return Fail(f"{exc.user} Nothing was written.", hint=f"run again: {again}   (log: {log})")
    if isinstance(exc, s.DeviceError):
        run.log.write("ERROR", f"USB error: {exc} (errno {exc.errno})")
        user = s.MSG_REMOVED if exc.errno == s.ENODEV else s.MSG_DEVICE
        return Fail(f"{user} Nothing was written.", hint=f"run again: {again}   (log: {log})")
    if isinstance(exc, (s.TransferTimeout, run.pk.calibration.CalibrationError)):
        run.log.write("ERROR", f"{type(exc).__name__}: {exc}")
        return Fail(f"{s.MSG_DEVICE} Nothing was written.", hint=f"run again: {again}   (log: {log})")
    raise exc


def calibrate(run: Run, serial: str, template: bytes, module: bytes, label: str) -> tuple[bytes, dict]:
    """The guarded calibration with retries; (the identify program, the calibration.json record)."""
    pk, pins = run.pk, run.pins
    s, cm = pk.session, pk.calib_model
    guard = functools.partial(
        s.check_command, module_sha256=pins.module_sha256, module_len=pins.module_len, skeletons=pins.skeletons
    )
    Sequence = sequence_class(s)
    stop_fprintd(run)
    transport = open_reader(run, guard)
    try:
        for attempt in range(1, MAX_ATTEMPTS + 1):
            fingers_off(run, first=attempt == 1)
            run.begin("Calibrating... ")
            run.log.write("INFO", f"calibration attempt {attempt} of {MAX_ATTEMPTS}")
            seq = Sequence(
                transport,
                run.log,
                template=template,
                module=module,
                guard=guard,
                say=lambda text: run.log.write("STEP", text),
            )
            seq.expected_serial = serial
            try:
                res = seq.calibrate()
            except BaseException as exc:
                if isinstance(exc, s.DeviceError) and exc.errno == s.ENODEV:
                    seq.device_gone = True
                seq.cleanup()
                with contextlib.suppress(OSError):  # the terminal may be gone (SIGHUP)
                    run.finish("stopped.")
                if isinstance(exc, Exception):
                    raise session_failure(run, exc) from None
                raise
            seq.cleanup()
            if res.bf is None:
                run.log.write("INFO", f"check score {res.score} > {cm.CHECK_MAX}: touched")
                run.finish("the reader seemed touched.")
                continue
            good, mean, sd = cm.bf_sanity(res.bf)
            run.log.write(
                "INFO", f"check score {res.score}; BF mean {mean:.2f}, sd {sd:.2f} ({'ok' if good else 'out of range'})"
            )
            if not good:
                run.finish("the reader seemed touched.")
                continue
            program = pk.calibration.assemble_cmd02(template, res.chunks())
            fine, why = pk.template.program_matches_template(program, pins=pins)
            if not fine:
                raise Fail(
                    f"The program built from the calibration does not match the template ({why}); nothing was written."
                )
            run.finish("done.")
            record = {
                "format": 1,
                "tool": PROG,
                "tool_version": TOOL_VERSION,
                "date": now_iso(),
                "how": "calibrated",
                "check_score": res.score,
                "check_max": cm.CHECK_MAX,
                "bf_mean": round(mean, 2),
                "bf_sd": round(sd, 2),
                "attempts": attempt,
                "module_uploaded": bool(res.module_uploaded),
                "template_sha256": pins.template_sha256,
                "vendor_files": label,
            }
            return program, record
        raise Fail(
            f"The reader seemed touched in {MAX_ATTEMPTS} attempts, so nothing was written. Wipe the reader, "
            "keep your fingers off it, then run again.",
            hint=run.next_command(),
        )
    finally:
        transport.close()


def resplice(run: Run, old_program: bytes, template: bytes) -> tuple[bytes, dict]:
    """The installed program's per-unit regions in the new template (no calibration)."""
    pk = run.pk
    try:
        program = pk.calibration.assemble_cmd02(template, pk.calibration.unit_regions(old_program))
    except pk.calibration.CalibrationError as exc:
        raise Fail(
            f"The installed program cannot be moved to the new template ({exc}).", hint=f"sudo {PROG} recalibrate"
        ) from None
    fine, why = pk.template.program_matches_template(program, pins=run.pins)
    if not fine:
        raise Fail(f"The re-spliced program does not match the template ({why}).", hint=f"sudo {PROG} recalibrate")
    record = run.calibration_record()
    record.update(
        format=1,
        tool=PROG,
        tool_version=TOOL_VERSION,
        how=record.get("how", "re-spliced"),
        resplice_date=now_iso(),
        template_sha256=run.pins.template_sha256,
    )
    record.setdefault("date", record["resplice_date"])
    return program, record


def backup_program(run: Run, serial: str, data: bytes) -> str:
    fd = run.open_setup_dir(BACKUP_NAME)
    try:
        stamp = datetime.datetime.now().astimezone().strftime("%Y%m%d-%H%M%S")
        name, n = program_name(f"{serial}-{stamp}"), 1
        while os.path.lexists(os.path.join(run.backup_dir, name)):
            n += 1
            name = program_name(f"{serial}-{stamp}-{n}")
        write_atomic(fd, name, data, run.cfg)
        os.fsync(fd)
    finally:
        os.close(fd)
    run.log.write("INFO", f"previous program kept as {run.backup_dir}/{name}")
    return name


def write_data_files(run: Run, serial: str, module: bytes, program: bytes) -> None:
    """module.bin and program-<serial>.bin through the phase A planner and atomic writer; lines to the log."""
    ds = DataSet(origin=PROG, module=module, programs={serial: program})
    with contextlib.redirect_stdout(LogLines(run.log)):
        plan = make_plan(run.cfg, ds, force=True, dry_run=False)
        if plan.refusals:
            raise Fail("Nothing was installed: " + "; ".join(plan.refusals))
        carry_out(plan, run.cfg)


def show_setup_plan(run: Run, files, inst: Installed, need_module_file: bool, action: str | None) -> None:
    say("dry run: nothing is changed")
    if inst.unreadable:
        say(
            f"  note  cannot look inside {run.cfg.state_dir} as {user_name(os.geteuid())} (root only): assuming nothing is installed"
        )
    if need_module_file or action:
        if files:
            say("  would read the vendor files from: " + ", ".join(os.path.abspath(f) for f in files))
        else:
            first = run.archives[0].label if run.archives else "none"
            say(f"  would use the vendor files saved in {run.vendor_dir}, else download them ({first} first)")
    if action == "calibrate":
        say("  would stop fprintd if it runs, and calibrate the reader (fingers off, about 10 seconds)")
    elif action == "resplice":
        say("  would move this reader's program to the new template (no calibration)")
    if need_module_file:
        say(f"  would install {MODULE_NAME} into {run.cfg.data_dir}")
    if action:
        say(f"  would install this reader's program into {run.cfg.data_dir}")
    say(f"dry run: nothing was changed; run the same command without --dry-run: sudo {PROG} {run.command}")


def preflight_dirs(run: Run, serial: str) -> None:
    """Refuse a symlinked or foreign target directory, or a symlinked (or not regular) module.bin
    or program of this reader, before any download or USB use: the write would refuse them after
    the calibration."""
    cfg = run.cfg
    for path in (cfg.state_dir, cfg.data_dir, cfg.setup_dir, run.vendor_dir, run.backup_dir):
        st = lstat_or_none(path)
        if st is not None and (why := dir_refusal(path, st, cfg)):
            raise Fail(f"Nothing was installed: {why}")
    for name in (MODULE_NAME, program_name(serial)):
        path = os.path.join(cfg.data_dir, name)
        st = lstat_or_none(path)
        if st is not None and stat.S_ISLNK(st.st_mode):
            raise Fail(f"Nothing was installed: {path} is a symlink; refusing to replace or follow it")
        if st is not None and not stat.S_ISREG(st.st_mode):
            raise Fail(f"Nothing was installed: {path} exists and is not a regular file")


def needs_root(cfg: Config, command: str, files: list[str], dry_run: bool) -> None:
    if not cfg.test_root and os.geteuid() != 0 and not dry_run:
        line = f"sudo {PROG} {command}" + "".join(f" --from-file {shlex.quote(os.path.abspath(f))}" for f in files)
        raise Fail(f"{command} needs root; nothing was changed. Run:\n  {line}", code=2)


def cmd_setup(cfg: Config, command: str, files: list[str], dry_run: bool, yes: bool) -> int:
    """install (no --from) and recalibrate."""
    needs_root(cfg, command, files, dry_run)
    run = Run(cfg, load_package(cfg), command, dry_run=dry_run, yes=yes)
    with run.logged():
        reader = one_reader(run)
        run.say(MSG_FOUND)
        serial = reader.serial
        if not dry_run:
            preflight_dirs(run, serial)
        inst = inspect_installed(run, serial)
        if command == "install" and inst.module is not None and inst.program_ok:
            if not dry_run:
                write_data_files(run, serial, inst.module, inst.program)  # only fixes a loose mode, if any
            run.say(
                "Already set up: the module and this reader's program are installed and valid. "
                "Enroll a finger with: fprintd-enroll"
            )
            return 0
        need_module_file = inst.module is None
        if command == "recalibrate":
            action = "calibrate"
        elif inst.program_ok:
            action = None
        elif inst.program is not None and resplice_pin(run, inst.program):
            action = "resplice"
        else:
            action = "calibrate"
        run.log.write("INFO", f"module.bin {'needed' if need_module_file else 'valid'}; program: {action or 'valid'}")
        if dry_run:
            show_setup_plan(run, files, inst, need_module_file, action)
            return 0
        need_template = action is not None
        need_module = need_module_file or action == "calibrate"
        g = Gathered(module=inst.module)
        if not g.satisfied(need_module, need_template):
            g = acquire(run, files, inst.module, need_module, need_template)
        module = g.module
        if action == "calibrate":
            program, record = calibrate(run, serial, g.template, module, g.label or "installed module")
        elif action == "resplice":
            run.begin("Moving this reader's program to the new template... ")
            program, record = resplice(run, inst.program, g.template)
            run.finish("done.")
        else:
            program, record = inst.program, None
        kept = None
        if inst.program is not None and (program != inst.program or command == "recalibrate"):
            kept = backup_program(run, serial, inst.program)
        write_data_files(run, serial, module, program)
        if record is not None:
            run.write_calibration_record(record)
        if command == "recalibrate" and kept:
            run.say(f"The previous program was kept in {run.backup_dir}.")
        elif kept and action == "calibrate":
            run.say(f"The previous program was not valid; it was kept in {run.backup_dir}.")
        run.say(f"Ready. Enroll a finger with: fprintd-enroll   (log: {cfg.log_path})")
    return 0


def cmd_fetch(cfg: Config, files: list[str], dry_run: bool) -> int:
    """The vendor files into the cache only; no reader needed."""
    needs_root(cfg, "fetch", files, dry_run)
    run = Run(cfg, load_package(cfg), "fetch", dry_run=dry_run)
    with run.logged():
        if dry_run:
            say("dry run: nothing is changed")
            if files:
                say("  would read and save: " + ", ".join(os.path.abspath(f) for f in files))
            else:
                say(f"  would check the vendor files saved in {run.vendor_dir}, else download them")
            say(f"dry run: nothing was changed; run the same command without --dry-run: sudo {PROG} fetch")
            return 0
        g = Gathered()
        if files:
            gather_from_files(run, files, g, False, False)  # keep whatever each file gives
            if g.module is None and g.template is None:
                raise Fail(
                    "The files given contain neither the module nor the DLL tables, so nothing was saved.",
                    hint=f"use one of the archives {PROG} status lists: sudo {PROG} fetch --from-file FILE",
                )
            if g.template is None:
                run.say("Saved. Note: " + MSG_BARE_MODULE)
        else:
            tried: set = set()
            if gather_from_cache(run, g, True, True, tried):
                run.say("Nothing to download: the vendor files are already saved.")
                return 0
            gather_from_network(run, g, True, True, tried)
        run.say(f"Saved in {run.vendor_dir}; sudo {PROG} install now works without the network.")
    return 0


