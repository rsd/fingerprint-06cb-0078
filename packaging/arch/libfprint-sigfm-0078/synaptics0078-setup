# ---------------------------------------------------------------------- install


@dataclasses.dataclass
class Plan:
    make_state_dir: bool = False
    make_data_dir: bool = False
    fix_mode_from: int | None = None  # the data dir's wrong mode, to set to 0700
    writes: list[tuple[str, bytes, str]] = dataclasses.field(default_factory=list)  # name, bytes, why
    fix_files: list[tuple[str, str]] = dataclasses.field(default_factory=list)  # identical file, its wrong mode/owner
    refusals: list[str] = dataclasses.field(default_factory=list)
    needs_force: bool = False  # a refusal that --force would lift


def lstat_or_none(path: str) -> os.stat_result | None:
    try:
        return os.lstat(path)
    except FileNotFoundError:
        return None


def dir_refusal(path: str, st: os.stat_result, cfg: Config) -> str | None:
    if stat.S_ISLNK(st.st_mode):
        return f"{path} is a symlink; refusing to write through it"
    if not stat.S_ISDIR(st.st_mode):
        return f"{path} exists and is not a directory"
    if st.st_uid != cfg.expect_uid:
        return f"{path} is owned by {user_name(st.st_uid)}, not {user_name(cfg.expect_uid)}; refusing to use it"
    return None


def file_attr_problem(st: os.stat_result, cfg: Config) -> str | None:
    """The mode and owner of an installed data file if they are not 0600 root:root, else None.

    Under a test root the owner expected is the test user, group not checked.
    """
    mode = stat.S_IMODE(st.st_mode)
    if cfg.test_root:
        owner_ok = st.st_uid == cfg.expect_uid
    else:
        owner_ok = st.st_uid == 0 and st.st_gid == 0
    if mode == FILE_MODE and owner_ok:
        return None
    return f"owner {user_name(st.st_uid)}:{group_name(st.st_gid)}, mode {mode:04o}"


def read_installed(path: str, size: int) -> tuple[os.stat_result, bytes | None]:
    """(fstat, bytes if the size is `size`) of an installed regular file; BadFile otherwise."""
    try:
        fd = os.open(path, _RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            raise BadFile("is a symlink; refusing to replace or follow it") from None
        raise
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise BadFile("exists and is not a regular file")
        if st.st_size != size:
            return st, None
        data = b""
        while len(data) <= size:
            chunk = os.read(fd, size + 1 - len(data))
            if not chunk:
                break
            data += chunk
        return st, data
    finally:
        os.close(fd)


def plan_file(plan: Plan, cfg: Config, name: str, data: bytes, force: bool, dry_run: bool) -> None:
    path = os.path.join(cfg.data_dir, name)
    try:
        st, current = read_installed(path, len(data))
    except FileNotFoundError:
        plan.writes.append((name, data, "new"))
        return
    except BadFile as exc:
        plan.refusals.append(f"{path} {exc}")
        return
    except PermissionError:
        if not dry_run:
            raise
        note(f"cannot read the installed {name} as {user_name(os.geteuid())} (root only): not checked")
        return
    if current == data:
        already(f"installed: {name} (identical)")
        if attrs := file_attr_problem(st, cfg):
            plan.fix_files.append((name, attrs))
        return
    if name == MODULE_NAME:
        # Only one module is valid, so an installed module that differs is invalid: replace it.
        why = module_problem(current, cfg.module_sha256) if current is not None else f"is {st.st_size} bytes"
        if why is not None:
            plan.writes.append((name, data, f"the installed one was not valid: it {why}"))
            return
    if force:
        plan.writes.append((name, data, "--force"))
        return
    plan.refusals.append(f"{name} is already installed with different contents (--force replaces it)")
    plan.needs_force = True


def make_plan(cfg: Config, ds: DataSet, force: bool, dry_run: bool) -> Plan:
    plan = Plan()
    st = lstat_or_none(cfg.state_dir)
    if st is not None and (why := dir_refusal(cfg.state_dir, st, cfg)):
        plan.refusals.append(why)
        return plan
    plan.make_state_dir = st is None
    try:
        st = None if plan.make_state_dir else lstat_or_none(cfg.data_dir)
    except PermissionError:
        if not dry_run:
            raise
        note(
            f"cannot look inside {cfg.state_dir} as {user_name(os.geteuid())} (root only): this plan assumes it is empty"
        )
        st = None
        plan.make_state_dir = False
    if st is not None:
        if why := dir_refusal(cfg.data_dir, st, cfg):
            plan.refusals.append(why)
            return plan
        if stat.S_IMODE(st.st_mode) != DIR_MODE:
            plan.fix_mode_from = stat.S_IMODE(st.st_mode)
    else:
        plan.make_data_dir = True
    targets = [(MODULE_NAME, ds.module)] + [(program_name(s), d) for s, d in sorted(ds.programs.items())]
    for name, data in targets:
        if plan.make_data_dir:
            plan.writes.append((name, data, "new"))
        else:
            plan_file(plan, cfg, name, data, force, dry_run)
    return plan


def open_or_make_dir(parent_fd: int, name: str, path: str, make: bool, cfg: Config) -> tuple[int, bool]:
    """(an fd of the directory `name` in parent_fd, whether this call created it).

    Created 0700 if `make`; one that appeared since the plan (EEXIST, e.g. fprintd
    making /var/lib/fprint) is opened like an existing one. Either way it is opened
    without following a symlink and checked again on the open fd.
    """
    created = False
    if make:
        try:
            os.mkdir(name, DIR_MODE, dir_fd=parent_fd)
            created = True
        except FileExistsError:
            pass
    try:
        fd = os.open(name, _DIR_FLAGS, dir_fd=parent_fd)
    except OSError as exc:
        # O_DIRECTORY | O_NOFOLLOW on a symlink fails with ENOTDIR on Linux, ELOOP elsewhere.
        if exc.errno in (errno.ELOOP, errno.ENOTDIR):
            st = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
            if why := dir_refusal(path, st, cfg):
                raise Fail(why) from None
        raise
    try:
        if created:
            if not cfg.test_root:
                os.fchown(fd, 0, 0)
            os.fchmod(fd, DIR_MODE)
            os.fsync(parent_fd)
        st = os.fstat(fd)
        if why := dir_refusal(path, st, cfg):
            raise Fail(why)
    except BaseException:
        os.close(fd)
        raise
    return fd, created


def fix_file_attrs(dir_fd: int, name: str, cfg: Config) -> None:
    """Set an installed file to 0600 root:root (test root: mode only) through an O_NOFOLLOW fd."""
    fd = os.open(name, _RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Fail(f"{os.path.join(cfg.data_dir, name)} is no longer a regular file; run the command again")
        if not cfg.test_root:
            os.fchown(fd, 0, 0)
        os.fchmod(fd, FILE_MODE)
        os.fsync(fd)
    finally:
        os.close(fd)


def write_atomic(dir_fd: int, name: str, data: bytes, cfg: Config) -> None:
    """Replace `name` in dir_fd by `data`, 0600 root:root: temp file, fsync, rename."""
    tmp = f".{name}.{secrets.token_hex(6)}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, FILE_MODE, dir_fd=dir_fd)
    try:
        try:
            view = memoryview(data)
            while view:
                view = view[os.write(fd, view) :]
            if not cfg.test_root:
                os.fchown(fd, 0, 0)
            os.fchmod(fd, FILE_MODE)
            os.fsync(fd)
        finally:
            os.close(fd)
        os.rename(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp, dir_fd=dir_fd)
        raise


def carry_out(plan: Plan, cfg: Config) -> None:
    parent = os.path.dirname(cfg.state_dir)
    parent_fd = os.open(parent, _RDONLY | os.O_DIRECTORY)
    try:
        state_fd, created = open_or_make_dir(
            parent_fd, os.path.basename(cfg.state_dir), cfg.state_dir, plan.make_state_dir, cfg
        )
    finally:
        os.close(parent_fd)
    if created:
        ok(f"created {cfg.state_dir} (mode 0700, {owner_text(cfg)})")
    try:
        data_fd, created = open_or_make_dir(
            state_fd, os.path.basename(cfg.data_dir), cfg.data_dir, plan.make_data_dir, cfg
        )
    finally:
        os.close(state_fd)
    try:
        if created:
            ok(f"created {cfg.data_dir} (mode 0700, {owner_text(cfg)})")
        elif (was := stat.S_IMODE(os.fstat(data_fd).st_mode)) != DIR_MODE:
            os.fchmod(data_fd, DIR_MODE)
            ok(f"set {cfg.data_dir} to mode 0700 (it was {was:04o})")
        for name, attrs in plan.fix_files:
            fix_file_attrs(data_fd, name, cfg)
            ok(f"set {name} to mode 0600, {owner_text(cfg)} (it was {attrs})")
        for name, data, why in plan.writes:
            write_atomic(data_fd, name, data, cfg)
            if why == "new":
                ok(f"installed {name} (mode 0600, {owner_text(cfg)})")
            else:
                ok(f"replaced {name} ({why})")
        os.fsync(data_fd)
    finally:
        os.close(data_fd)


def show_plan(plan: Plan, cfg: Config) -> None:
    if plan.make_state_dir:
        print(f"  would create {cfg.state_dir} (mode 0700, {owner_text(cfg)})")
    if plan.make_data_dir:
        print(f"  would create {cfg.data_dir} (mode 0700, {owner_text(cfg)})")
    if plan.fix_mode_from is not None:
        print(f"  would set {cfg.data_dir} to mode 0700 (it is {plan.fix_mode_from:04o})")
    for name, attrs in plan.fix_files:
        print(f"  would set {name} to mode 0600, {owner_text(cfg)} (it is {attrs})")
    for name, _, why in plan.writes:
        if why == "new":
            print(f"  would install {name} (mode 0600, {owner_text(cfg)})")
        else:
            print(f"  would replace {name} ({why})")


def sudo_line(source: str, force: bool) -> str:
    line = f"sudo {PROG} install --from {shlex.quote(source)}"
    return line + " --force" if force else line


def cmd_install(cfg: Config, source: str, force: bool, dry_run: bool) -> int:
    """Phase A: install --from DIR."""
    source = os.path.abspath(source)
    if not cfg.test_root and os.geteuid() != 0 and not dry_run:
        raise Fail(
            "install needs root; nothing was changed. Run:\n  " + sudo_line(source, force),
            code=2,
        )
    print(f"{PROG} install: data from {source}" + (f" (TEST ROOT {cfg.test_root})" if cfg.test_root else ""))
    if dry_run:
        print("dry run: nothing is changed")

    print(f"checking the files in {source}:")
    if cfg.source_unchecked:
        note(f"not run through sudo ({SUDO_UID_VAR} is not set): the owner of {source} was not checked")
    ds = load_from_dir(source, cfg.source_uid)
    results = check_dataset(ds, cfg)
    for check in results:
        if check.problem is None:
            ok(f"{check.name} ({describe_ok(check.name)})")
        else:
            failed(f"{check.name} {check.problem}")
    for name in ds.others:
        note(f"ignored: {name} (not a data file)")
    if any(check.problem is not None for check in results):
        raise Fail("nothing was installed: fix the files marked FAILED above", hint=SOURCE_HINT)

    print(f"installing into {cfg.data_dir}:")
    plan = make_plan(cfg, ds, force, dry_run)
    if plan.refusals:
        for why in plan.refusals:
            failed(why)
        hint = f"to replace them, run: {sudo_line(source, True)}" if plan.needs_force else ""
        raise Fail("nothing was installed", hint=hint)
    if dry_run:
        show_plan(plan, cfg)
        print("dry run: nothing was changed; run the same command without --dry-run to install")
        return 0
    carry_out(plan, cfg)
    print(DONE_LINE)
    return 0


