def source_owner(environ, applies: bool) -> tuple[int | None, bool]:
    """(the uid the source must belong to, whether its owner goes unchecked).

    It applies to a root run, which can read anything, and to a test root standing
    in for one. SUDO_UID is sudo's own variable, not a test hook: it only adds a
    check, and without it a root run reads the source as before and says so.
    """
    if not applies:
        return None, False
    raw = environ.get(SUDO_UID_VAR, "")
    if raw == "":
        return None, True
    if not (raw.isascii() and raw.isdigit()):
        raise Fail(f"{SUDO_UID_VAR} is not a number; refusing to guess whose files to read", code=2)
    return int(raw), False


def checkout_libdir() -> str:
    """The fingerprint-06cb-0078 checkout this script is in (packaging/arch/<pkg>/<script>)."""
    path = os.path.realpath(__file__)
    for _ in range(4):
        path = os.path.dirname(path)
    return path


def _hook_path(environ, var: str, default: str) -> str:
    value = environ.get(var, "")
    if value == "":
        return default
    if not os.path.isabs(value):
        raise Fail(f"{var} must be an absolute path", code=2)
    return value


def _pins_module_sha256(path: str) -> str:
    """The module pin in a pins file (the whole file is checked once the package is loaded)."""
    try:
        with open(path, encoding="utf-8") as fh:
            doc = json.loads(fh.read(MAX_SMALL_FILE))
        value = doc["module_sha256"]
    except (OSError, ValueError, KeyError, TypeError, RecursionError) as exc:
        raise Fail(f"{TEST_PINS_VAR}: cannot read a pins document from {path} ({exc})", code=2) from None
    if not isinstance(value, str) or not SHA256_RE.fullmatch(value):
        raise Fail(f"{TEST_PINS_VAR}: module_sha256 in {path} is not a sha256", code=2)
    return value


def load_config(environ, real_euid: int) -> Config:
    """The paths and pins to use; the test hooks only when not root.

    As root (or as a test faking root through TEST_EUID) any test variable makes
    the tool refuse to run: sudo -E or env_keep could otherwise carry one in.
    """
    guard_euid = real_euid
    if real_euid != 0 and environ.get(TEST_EUID_VAR, "") != "":
        try:
            guard_euid = int(environ[TEST_EUID_VAR])
        except ValueError:
            raise Fail(f"{TEST_EUID_VAR} must be a number", code=2) from None
    if guard_euid == 0:
        for var in TEST_VARS:
            if var in environ:
                raise Fail(
                    f"{var} is set; the test-only variables are refused as root",
                    hint=f"unset it (sudo -E and env_keep pass it on): sudo env -u {var} {PROG} ...",
                    code=2,
                )
    proxies = tuple((k, environ[k]) for k in PROXY_VARS if environ.get(k))
    if real_euid == 0:  # reached only with no test variable set
        return Config("", MODULE_SHA256, 0, STATE_DIR, DATA_DIR, *source_owner(environ, True), proxies=proxies)
    test_root = environ.get(TEST_ROOT_VAR, "")
    if test_root:
        if not os.path.isabs(test_root):
            raise Fail(f"{TEST_ROOT_VAR} must be an absolute path", code=2)
        test_root = os.path.realpath(test_root)
    module_sha256 = environ.get(TEST_SHA_VAR, "") or MODULE_SHA256
    pins_path = _hook_path(environ, TEST_PINS_VAR, "")
    if pins_path:
        from_pins = _pins_module_sha256(pins_path)
        if environ.get(TEST_SHA_VAR, "") not in ("", from_pins):
            raise Fail(f"{TEST_SHA_VAR} and the module pin in {TEST_PINS_VAR} differ", code=2)
        module_sha256 = from_pins
    expect_uid = os.getuid() if test_root else 0
    return Config(
        test_root,
        module_sha256,
        expect_uid,
        test_root + STATE_DIR,
        test_root + DATA_DIR,
        *source_owner(environ, bool(test_root)),
        pins_path=pins_path,
        archives_path=_hook_path(environ, TEST_ARCHIVES_VAR, ""),
        libdir=_hook_path(environ, TEST_LIBDIR_VAR, checkout_libdir() if test_root else LIBDIR),
        curl=_hook_path(environ, TEST_CURL_VAR, test_root + CURL),
        systemctl=_hook_path(environ, TEST_SYSTEMCTL_VAR, test_root + SYSTEMCTL),
        setpriv=_hook_path(environ, TEST_SETPRIV_VAR, test_root + SETPRIV),
        prlimit=_hook_path(environ, TEST_PRLIMIT_VAR, test_root + PRLIMIT),
        sysfs=_hook_path(environ, TEST_SYSFS_VAR, test_root + SYSFS),
        transport_path=_hook_path(environ, TEST_TRANSPORT_VAR, ""),
        setup_dir=test_root + SETUP_DIR,
        log_path=test_root + LOG_PATH,
        check_template=not (environ.get(TEST_SHA_VAR, "") and not pins_path),
        proxies=proxies,
    )


# ------------------------------------------------------------- the shared package


def tree_problem(pkgdir: str, owners: frozenset[int] | set[int], top: str = "/") -> str | None:
    """Why the package directory `pkgdir` cannot be trusted, or None.

    Every directory from `top` down to `pkgdir` and everything inside `pkgdir` must be a
    real directory or regular file (no symlink, nothing else), owned by one of `owners`,
    and not writable by group or others. lstat only: nothing is followed.

    One exception, the usual one for a path above the trusted files: a directory above
    `pkgdir` that is owned by root and has the sticky bit (/tmp, where makepkg builds
    with BUILDDIR=/tmp/makepkg) may be writable by others, since nobody but root and the
    owner of an entry in it can rename or remove that entry, and the entry itself is
    checked next. Never `pkgdir` itself nor anything inside it.
    """
    rel = os.path.relpath(pkgdir, top)
    if rel == ".." or rel.startswith("../"):
        return f"{pkgdir} is not under {top}"
    chain, here = [top], top
    for part in [] if rel == "." else rel.split("/"):
        here = os.path.join(here, part)
        chain.append(here)

    def problem(path: str, want_dir: bool | None, above: bool = False) -> str | None:
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            return f"{path} does not exist"
        except OSError as exc:
            return f"{path} cannot be checked: {exc.strerror}"
        if stat.S_ISLNK(st.st_mode):
            return f"{path} is a symlink"
        if want_dir and not stat.S_ISDIR(st.st_mode):
            return f"{path} is not a directory"
        if not (stat.S_ISDIR(st.st_mode) or stat.S_ISREG(st.st_mode)):
            return f"{path} is not a regular file or directory"
        if st.st_uid not in owners:
            return (
                f"{path} is owned by {user_name(st.st_uid)}, not by {' or '.join(user_name(u) for u in sorted(owners))}"
            )
        if st.st_mode & 0o022 and not (above and st.st_uid == 0 and st.st_mode & stat.S_ISVTX):
            return f"{path} is writable by its group or by others (mode {stat.S_IMODE(st.st_mode):04o})"
        return None

    for d in chain:
        if why := problem(d, True, above=d != chain[-1]):
            return why
    if why := problem(os.path.join(pkgdir, "__init__.py"), False):
        return why
    for root, dirs, files in os.walk(pkgdir):
        for name in sorted(dirs) + sorted(files):
            if why := problem(os.path.join(root, name), None):
                return why
    return None


@dataclasses.dataclass
class Package:
    """The modules of the shared synaptics0078 package, loaded from a checked directory."""

    pkgdir: str
    pins: object
    calibration: object
    calib_model: object
    template: object
    vendor: object
    session: object


def load_package(cfg: Config) -> Package:
    """Load synaptics0078 from cfg.libdir after tree_problem passed; by file location, not sys.path."""
    pkgdir = os.path.join(os.path.realpath(cfg.libdir), PACKAGE)
    owners = {0} if os.geteuid() == 0 else {0, os.geteuid()}
    if why := tree_problem(pkgdir, owners):
        raise Fail(
            f"the {PACKAGE} package in {cfg.libdir} cannot be trusted: {why}; nothing was done",
            hint="reinstall it: sudo pacman -S libfprint-sigfm-0078" if not cfg.test_root else "",
            code=2,
        )
    init = os.path.join(pkgdir, "__init__.py")
    have = sys.modules.get(PACKAGE)
    if have is not None:
        where = getattr(have, "__file__", None) or ""
        if os.path.realpath(where) != os.path.realpath(init):
            raise Fail(f"another {PACKAGE} package is already loaded ({where}); nothing was done", code=2)
    else:
        spec = importlib.util.spec_from_file_location(PACKAGE, init, submodule_search_locations=[pkgdir])
        module = importlib.util.module_from_spec(spec)
        sys.modules[PACKAGE] = module
        try:
            spec.loader.exec_module(module)
        except BaseException:
            del sys.modules[PACKAGE]
            raise
    mods = {
        n: importlib.import_module(f"{PACKAGE}.{n}")
        for n in ("pins", "calibration", "calib_model", "template", "vendor", "session")
    }
    pk = Package(pkgdir=pkgdir, **mods)
    p = pk.pins
    if (p.MODULE_LEN, p.MODULE_SHA256, p.TEMPLATE_LEN) != (MODULE_SIZE, MODULE_SHA256, PROGRAM_SIZE):
        raise Fail(f"the {PACKAGE} package in {cfg.libdir} does not belong to this tool (other pins)", code=2)
    return pk


def child_code(pkgdir: str) -> str:
    """The -c program of the unprivileged extractor: load the checked package, run vendor.child_entry()."""
    init = os.path.join(pkgdir, "__init__.py")
    return (
        "import importlib.util as u, sys; "
        f"s = u.spec_from_file_location({PACKAGE!r}, {init!r}, submodule_search_locations=[{pkgdir!r}]); "
        "m = u.module_from_spec(s); sys.modules[s.name] = m; s.loader.exec_module(m); "
        f"from {PACKAGE} import vendor; sys.exit(vendor.child_entry())"
    )


# ------------------------------------------------------------------- data source
# The data SOURCE is one function returning a DataSet; checking it and installing it
# are separate steps that never look at where the bytes came from. Phase A reads a
# directory prepared on Windows-derived inputs (load_from_dir). Phase B (cmd_setup)
# feeds the same install path: the module from the public vendor download (hash-checked
# against the same pin) and the program built from calibration read on the sensor.


@dataclasses.dataclass
class DataSet:
    origin: str  # where the bytes came from, for messages
    module: bytes | None = None
    programs: dict[str, bytes] = dataclasses.field(default_factory=dict)  # serial as named -> bytes
    unreadable: dict[str, str] = dataclasses.field(default_factory=dict)  # file name -> why it was not read
    others: list[str] = dataclasses.field(default_factory=list)  # names that are not data files
    stats: dict[str, os.stat_result] = dataclasses.field(default_factory=dict)  # file name -> fstat of what was read


def program_name(serial: str) -> str:
    return f"program-{serial}.bin"


def not_owner_text(uid: int, owner_uid: int) -> str:
    return f"is owned by {user_name(uid)}, not by {user_name(owner_uid)} who ran sudo"


def open_checked(path: str, owner_uid: int | None = None, dir_fd: int | None = None) -> tuple[int, os.stat_result]:
    """(an fd open for reading, its fstat) of the regular file `path` (no symlink).

    The name is first opened with O_PATH | O_NOFOLLOW, which opens nothing of the file
    itself (no device driver is started, no FIFO waited on, nothing is readable through
    it): the type and the owner (when `owner_uid` is given) are checked on that fd. Only
    a regular file is then opened for reading, through /proc/self/fd/N, which reaches the
    inode already checked and not the name again (that reopen cannot carry O_NOFOLLOW:
    /proc/self/fd/N is itself a link, the one to follow), and its fstat must show the
    same device and inode.
    """
    try:
        pfd = os.open(path, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dir_fd)
    except FileNotFoundError:
        raise BadFile("does not exist") from None
    except OSError as exc:
        raise BadFile(f"cannot be opened: {exc.strerror}") from None
    try:
        st = os.fstat(pfd)
        if stat.S_ISLNK(st.st_mode):
            raise BadFile("is a symlink; give the file itself")
        if owner_uid is not None and st.st_uid != owner_uid:
            raise BadFile(f"{not_owner_text(st.st_uid, owner_uid)}; not read")
        if not stat.S_ISREG(st.st_mode):
            raise BadFile("is not a regular file")
        try:
            fd = os.open(f"/proc/self/fd/{pfd}", _RDONLY | os.O_NONBLOCK)
        except OSError as exc:
            raise BadFile(f"cannot be opened: {exc.strerror}") from None
    finally:
        os.close(pfd)
    try:
        again = os.fstat(fd)
        if (again.st_dev, again.st_ino) != (st.st_dev, st.st_ino) or not stat.S_ISREG(again.st_mode):
            raise BadFile("changed while it was read; run the command again")
    except BaseException:
        os.close(fd)
        raise
    return fd, again


def read_regular_at(dir_fd: int, name: str, size: int, owner_uid: int | None = None) -> tuple[bytes, os.stat_result]:
    """The bytes and fstat of `name` in dir_fd: a regular file (no symlink) of exactly `size` bytes.

    The type, the owner (when `owner_uid` is given) and the size are checked before the
    file is opened for reading (open_checked); the file is read once, and a file that
    changes size meanwhile is refused.
    """
    fd, st = open_checked(name, owner_uid, dir_fd=dir_fd)
    try:
        if st.st_size != size:
            raise BadFile(f"is {st.st_size} bytes, expected {size}")
        chunks = []
        left = size + 1  # one byte more: notice a file that grew
        while left > 0:
            chunk = os.read(fd, left)
            if not chunk:
                break
            chunks.append(chunk)
            left -= len(chunk)
        data = b"".join(chunks)
    finally:
        os.close(fd)
    if len(data) != size:
        raise BadFile("changed while it was read; run the command again")
    return data, st


def read_capped(path: str, cap: int, owner_uid: int | None = None, dir_fd: int | None = None) -> bytes:
    """The bytes of a regular file (no symlink) of at most `cap` bytes, read once.

    Type, owner (when `owner_uid` is given) and size are checked before the file is
    opened for reading (open_checked); a file that changes size meanwhile is refused.
    """
    fd, st = open_checked(path, owner_uid, dir_fd=dir_fd)
    try:
        if st.st_size > cap:
            raise BadFile(f"is {st.st_size} bytes, more than the {cap >> 20} MB allowed")
        chunks, got = [], 0
        while got <= st.st_size:
            chunk = os.read(fd, st.st_size + 1 - got)
            if not chunk:
                break
            chunks.append(chunk)
            got += len(chunk)
        data = b"".join(chunks)
    finally:
        os.close(fd)
    if len(data) != st.st_size:
        raise BadFile("changed while it was read; run the command again")
    return data


def open_dir_nofollow(path: str) -> int:
    try:
        return os.open(path, _DIR_FLAGS)
    except FileNotFoundError:
        raise Fail(f"no directory {path}", hint=SOURCE_HINT) from None
    except OSError as exc:
        # O_DIRECTORY | O_NOFOLLOW on a symlink fails with ENOTDIR on Linux, ELOOP elsewhere.
        if exc.errno == errno.ELOOP or (exc.errno == errno.ENOTDIR and os.path.islink(path)):
            raise Fail(f"{path} is a symlink; give the directory itself") from None
        if exc.errno == errno.ENOTDIR:
            raise Fail(f"{path} is not a directory") from None
        raise Fail(f"cannot open {path}: {exc.strerror}") from None


def load_from_dir(path: str, owner_uid: int | None = None) -> DataSet:
    """Phase A source: module.bin and every program-*.bin in the directory `path`.

    With `owner_uid` (the user who ran sudo) the directory must belong to that user,
    checked before anything in it is listed, and a data file of another owner is
    refused unread.
    """
    ds = DataSet(origin=path)
    dir_fd = open_dir_nofollow(path)
    try:
        if owner_uid is not None and (uid := os.fstat(dir_fd).st_uid) != owner_uid:
            raise Fail(
                f"{path} {not_owner_text(uid, owner_uid)}; refusing to look inside it",
                hint="give a directory of your own: " + SOURCE_HINT,
            )
        for name in sorted(os.listdir(dir_fd)):
            match = PROGRAM_NAME_RE.fullmatch(name)
            if name == MODULE_NAME:
                size = MODULE_SIZE
            elif match:
                size = PROGRAM_SIZE
            else:
                ds.others.append(name)
                continue
            try:
                data, ds.stats[name] = read_regular_at(dir_fd, name, size, owner_uid)
            except BadFile as exc:
                ds.unreadable[name] = str(exc)
                continue
            if match:
                ds.programs[match.group(1)] = data
            else:
                ds.module = data
    finally:
        os.close(dir_fd)
    return ds


# -------------------------------------------------------------------- validation


def module_problem(data: bytes, expected_sha256: str) -> str | None:
    """Why `data` is not the module the driver accepts, or None."""
    if len(data) != MODULE_SIZE:
        return f"is {len(data)} bytes, expected {MODULE_SIZE}"
    got = hashlib.sha256(data).hexdigest()
    if got != expected_sha256:
        return f"has sha256 {got}, expected {expected_sha256} (not the module this driver needs)"
    return None


def program_problem(serial: str, data: bytes) -> str | None:
    """Why `data`, named program-<serial>.bin, is not a program the driver accepts, or None."""
    if not SERIAL_RE.fullmatch(serial):
        return "is not named program-<12 lowercase hex characters>.bin"
    if len(data) != PROGRAM_SIZE:
        return f"is {len(data)} bytes, expected {PROGRAM_SIZE}"
    if data[0] != PROGRAM_OPCODE:
        return f"starts with 0x{data[0]:02x}, expected 0x{PROGRAM_OPCODE:02x}"
    return None


@dataclasses.dataclass(frozen=True)
class Check:
    name: str
    problem: str | None  # None: valid
    present: bool  # False: the file is missing


def check_dataset(ds: DataSet, cfg: Config) -> list[Check]:
    """One Check per data file, module.bin first; a missing module or program is one too."""
    out = [Check(name, why, True) for name, why in ds.unreadable.items()]
    if ds.module is not None:
        out.append(Check(MODULE_NAME, module_problem(ds.module, cfg.module_sha256), True))
    elif MODULE_NAME not in ds.unreadable:
        out.append(Check(MODULE_NAME, f"is missing from {ds.origin}", False))
    for serial, data in ds.programs.items():
        out.append(Check(program_name(serial), program_problem(serial, data), True))
    if not ds.programs and not any(PROGRAM_NAME_RE.fullmatch(n) for n in ds.unreadable):
        out.append(Check("program-<serial>.bin", f"is missing from {ds.origin}: there is none", False))
    return sorted(out, key=lambda c: (c.name != MODULE_NAME, c.name))


def describe_ok(name: str) -> str:
    """What was checked on the valid file `name`."""
    if name == MODULE_NAME:
        return f"{MODULE_SIZE} bytes, sha256 ok"
    serial = PROGRAM_NAME_RE.fullmatch(name).group(1)
    return f"serial {serial}, {PROGRAM_SIZE} bytes, starts with 0x{PROGRAM_OPCODE:02x}"


