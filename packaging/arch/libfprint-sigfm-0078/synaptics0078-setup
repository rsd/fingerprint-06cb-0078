def status_sources(run: Run) -> None:
    print("vendor file sources (tried in this order; for --from-file any one of them will do):")
    for i, a in enumerate(run.archives, 1):
        print(f"  {i}. {a.label}: {a.url}")


def status_reader(run: Run) -> tuple[Reader | None, bool]:
    """(the one reader, whether the reader side is fine): no reader at all is a note, not a failure."""
    print("reader:")
    readers = find_readers(run.cfg)
    if not readers:
        note("no 06cb:0078 reader found in sysfs (is it enabled in the firmware setup?): programs not matched to it")
        return None, True
    if len(readers) > 1:
        failed(f"{len(readers)} readers 06cb:0078 found; this tool sets up one (unplug the others)")
        return None, False
    reader = readers[0]
    if not SERIAL_RE.fullmatch(reader.serial):
        failed("06cb:0078 found, but its USB serial number cannot be read (restart the computer)")
        return None, False
    ok("06cb:0078 found (USB serial readable)")
    return reader, True


def status_setup_dir(run: Run) -> None:
    """The vendor cache and the last calibration (information; not part of ready)."""
    cfg = run.cfg
    print(f"vendor files saved in {run.vendor_dir}:")
    try:
        st = os.lstat(cfg.setup_dir)
        fd = os.open(cfg.setup_dir, _DIR_FLAGS) if stat.S_ISDIR(st.st_mode) else None
    except FileNotFoundError:
        note(f"nothing saved yet: install downloads them (or ahead of time: sudo {PROG} fetch)")
        return
    except PermissionError:
        note(f"readable by root only; to see it: sudo {PROG} status")
        return
    if fd is None:
        failed(f"{cfg.setup_dir} is not a directory")
        return
    try:
        try:
            vfd = os.open(VENDOR_NAME, _DIR_FLAGS, dir_fd=fd)
        except FileNotFoundError:
            vfd = None
            note(f"nothing saved yet: install downloads them (or ahead of time: sudo {PROG} fetch)")
        except OSError as exc:
            vfd = None
            failed(f"cannot look inside: {exc.strerror}")
        if vfd is not None:
            try:
                manifest = run.read_json_at(vfd, MANIFEST_NAME)
                names = cache_names(run, vfd)
                for name in names:
                    entry = manifest.get(name) if isinstance(manifest.get(name), dict) else {}
                    gave = entry.get("gave") if isinstance(entry.get("gave"), list) else []
                    gave_s = " and ".join(_safe(x, 20) for x in gave) or "not recorded"
                    when = _safe(entry.get("date", "date not recorded"), 40)
                    ok(f"{entry_label(run, name, manifest)} ({_safe(name[65:], 40)}): gave {gave_s}; saved {when}")
                if not names:
                    note(f"nothing saved yet: install downloads them (or ahead of time: sudo {PROG} fetch)")
            finally:
                os.close(vfd)
        record = run.read_json_at(fd, CALIBRATION_NAME)
        if record:
            score, bf = record.get("check_score"), (record.get("bf_mean"), record.get("bf_sd"))
            text = f"last calibration: {_safe(record.get('date', '?'), 40)}"
            if isinstance(score, int):
                text += f", check score {score} (limit {record.get('check_max', 200)})"
            if all(isinstance(x, int | float) for x in bf):
                text += f", baseline mean {bf[0]:.1f}, sd {bf[1]:.1f}"
            if record.get("resplice_date"):
                text += f"; moved to the current template {_safe(record['resplice_date'], 40)}"
            print(text)
    finally:
        os.close(fd)


def cmd_status(cfg: Config) -> int:
    me = user_name(os.geteuid())
    print(f"{PROG} status (as {me})" + (f" (TEST ROOT {cfg.test_root})" if cfg.test_root else ""))
    run = Run(cfg, load_package(cfg), "status")
    status_sources(run)
    reader, reader_ok = status_reader(run)
    if reader is not None:
        run.redact.add_serial(reader.serial)
    print(f"data directory: {cfg.data_dir}")
    try:
        st = os.lstat(cfg.data_dir)
        if stat.S_ISDIR(st.st_mode):
            os.close(os.open(cfg.data_dir, _DIR_FLAGS))  # can we list it?
    except FileNotFoundError:
        failed("missing: nothing is installed yet")
        print(f"  install with: sudo {PROG} install")
        print(f"  (or from files made on Windows: sudo {PROG} install --from DIR")
        print(f"   DIR: {SOURCE_HINT})")
        return 1
    except PermissionError:
        print(f"  {cfg.state_dir} is readable by root only, so {me} cannot see inside it. Run:")
        print(f"    sudo {PROG} status")
        return 1
    good = reader_ok
    if stat.S_ISLNK(st.st_mode):
        failed("is a symlink; the driver needs a real directory")
        return 1
    if not stat.S_ISDIR(st.st_mode):
        failed("exists and is not a directory")
        return 1
    mode = stat.S_IMODE(st.st_mode)
    where = f"owner {user_name(st.st_uid)}:{group_name(st.st_gid)}, mode {mode:04o}"
    if st.st_uid != cfg.expect_uid:
        failed(f"{where}: expected owner {user_name(cfg.expect_uid)}")
        good = False
    elif mode != DIR_MODE:
        failed(f"{where}: expected mode 0700 (install sets it)")
        good = False
    else:
        ok(f"exists, {where}")

    ds = load_from_dir(cfg.data_dir)
    valid_programs = set()
    for check in check_dataset(ds, cfg):
        problem = check.problem
        match = PROGRAM_NAME_RE.fullmatch(check.name)
        if problem is None and match and match.group(1) in ds.programs:
            problem = program_check(run, match.group(1), ds.programs[match.group(1)])
        if problem is None:
            if attrs := file_attr_problem(ds.stats[check.name], cfg):
                failed(f"{check.name}: valid, but {attrs}: expected mode 0600, {owner_text(cfg)} (install sets it)")
                good = False
            else:
                extra = ", matches the template" if match and cfg.check_template else ""
                ok(f"{check.name}: valid ({describe_ok(check.name)}{extra})")
                if match:
                    valid_programs.add(match.group(1))
        elif check.present:
            failed(f"{check.name}: invalid: it {problem}")
            good = False
        else:
            failed(f"{check.name}: missing")
            good = False
    for name in ds.others:
        note(f"other file (not used by the driver): {name}")
    if reader is not None:
        if reader.serial in valid_programs:
            ok("this reader's program is installed and valid")
        else:
            failed(f"this reader has no valid program: sudo {PROG} install")
            good = False
    status_setup_dir(run)
    if good:
        print("ready: the driver finds valid data files")
        return 0
    print(f"not ready: see the FAILED lines above; fix with: sudo {PROG} install")
    return 1


# ------------------------------------------------------------------------- main


def build_parser() -> argparse.ArgumentParser:
    fmt = argparse.RawDescriptionHelpFormatter
    p = argparse.ArgumentParser(
        prog=PROG,
        formatter_class=fmt,
        description=(
            "Set up and check the data files of the libfprint synaptics0078 driver\n"
            f"(Synaptics 06cb:0078 fingerprint reader) in {DATA_DIR}."
        ),
        epilog=(
            "Usual use (downloads the public vendor files, calibrates the reader, installs):\n"
            f"  sudo {PROG} install\n"
            f"  {PROG} status\n"
            "Offline: download a vendor archive elsewhere (status lists the URLs), then\n"
            f"  sudo {PROG} install --from-file FILE\n"
            "Files made on Windows (phase A): tools/synaptics0078_data.py in the\n"
            "fingerprint-06cb-0078 project builds module.bin and program-<serial>.bin from\n"
            "the Windows driver files (run it as your user; it writes local/synaptics0078). Then:\n"
            f"  sudo {PROG} install --from <that directory>"
        ),
    )
    sub = p.add_subparsers(dest="command", required=True, metavar="{install,recalibrate,fetch,status}")

    def common(sp, yes: bool = True):
        sp.add_argument(
            "--from-file",
            dest="from_files",
            metavar="FILE",
            action="append",
            default=[],
            help="vendor file to use instead of the cache and the download (cab, zip, exe, MSI, DLL, "
            "module, template); repeatable",
        )
        sp.add_argument(
            "--dry-run", action="store_true", help="print what would be done, change nothing (no root needed)"
        )
        if yes:
            sp.add_argument(
                "--yes", action="store_true", help="no Enter prompt: a 3-second countdown before calibrating"
            )

    inst = sub.add_parser(
        "install",
        formatter_class=fmt,
        help="set up whatever is missing: vendor files, calibration, data files (as root)",
        description=(
            f"Without --from: find the reader, get the vendor files (cache in {SETUP_DIR}/vendor,\n"
            "else download, or --from-file), calibrate the reader (fingers off) and install\n"
            f"module.bin and program-<serial>.bin into {DATA_DIR}.\n"
            "Already set up (valid module, valid program for this reader): nothing is done.\n\n"
            f"With --from DIR: check the files in DIR, then copy them into {DATA_DIR}\n"
            "(directory 0700, files 0600, root:root). Nothing is written unless every\n"
            "file is valid, and nothing is ever deleted. An installed program that\n"
            "differs is kept unless --force is given."
        ),
    )
    inst.add_argument(
        "--from", dest="source", metavar="DIR", help="directory with data files made on Windows (phase A)"
    )
    inst.add_argument("--force", action="store_true", help="with --from: replace an installed program that differs")
    common(inst)
    rec = sub.add_parser(
        "recalibrate",
        formatter_class=fmt,
        help="calibrate the reader again (the previous program is kept)",
        description=f"Calibrate the reader again and install the new program; the previous one is kept in\n{SETUP_DIR}/backup.",
    )
    common(rec)
    fetch = sub.add_parser(
        "fetch",
        formatter_class=fmt,
        help="get the vendor files into the cache only (no reader needed)",
        description=f"Get and check the vendor files, and keep them in {SETUP_DIR}/vendor\nso a later install works offline.",
    )
    common(fetch, yes=False)
    sub.add_parser(
        "status",
        help="show what is installed (sudo shows inside /var/lib)",
        description=f"Show {DATA_DIR}, the reader, the cache and the sources.\nExit 0 when the driver can use the files, else 1.",
    )
    return p


def main(argv: list[str] | None = None, environ=None) -> int:
    environ = os.environ if environ is None else environ
    _pending[0] = False
    try:
        cfg = load_config(environ, os.geteuid())
        args = build_parser().parse_args(argv)
        if args.command == "install" and args.source is not None:
            if args.from_files:
                raise Fail("--from and --from-file cannot be combined", code=2)
            return cmd_install(cfg, args.source, args.force, args.dry_run)
        if getattr(args, "force", False):
            raise Fail("--force applies only to install --from DIR", code=2)
        if args.command in ("install", "recalibrate"):
            return cmd_setup(cfg, args.command, args.from_files, args.dry_run, args.yes)
        if args.command == "fetch":
            return cmd_fetch(cfg, args.from_files, args.dry_run)
        return cmd_status(cfg)
    except Fail as exc:
        end_pending_line()
        sys.stdout.flush()
        print(f"FAILED: {exc}", file=sys.stderr)
        if exc.hint:
            print(f"  hint: {exc.hint}", file=sys.stderr)
        return exc.code
    except KeyboardInterrupt:
        with contextlib.suppress(OSError):  # the terminal may be gone (SIGHUP)
            end_pending_line()
            sys.stdout.flush()
            print("Interrupted. Nothing more was written.", file=sys.stderr)
        return 130
    except OSError as exc:
        end_pending_line()
        sys.stdout.flush()
        print(f"FAILED: {exc}", file=sys.stderr)
        return 1


# SIGTERM (systemd, kill) and SIGHUP (the terminal closed, relayed by sudo too) stop the
# run like Ctrl-C: the reader gets its 04/52 and is released, nothing more is written.
STOP_SIGNALS = (signal.SIGTERM, signal.SIGHUP)


def _on_stop_signal(signum, frame):
    # Once is enough: a second one (the kernel's hangup and sudo's relayed copy) must not
    # cut the cleanup that the first one started short.
    for sig in STOP_SIGNALS:
        signal.signal(sig, signal.SIG_IGN)
    raise KeyboardInterrupt


def install_signal_handlers() -> None:
    for sig in STOP_SIGNALS:
        signal.signal(sig, _on_stop_signal)


if __name__ == "__main__":
    os.umask(0o077)  # belt and braces: every mode is also set explicitly
    install_signal_handlers()
    sys.exit(main())
